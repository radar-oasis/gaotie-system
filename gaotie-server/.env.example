# Pattern graph database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# DeepSeek chat and intent parsing
DEEPSEEK_API_KEY=

# Shared Ark-compatible image generation credentials.
# Optional text-only prompt enhancement. Set a real key in ignored .env.local.
# Falls back to DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL.
# No reference image bytes or image URLs are sent to this endpoint.
PROMPT_ENHANCER_API_KEY=
PROMPT_ENHANCER_BASE_URL=https://api.deepseek.com
PROMPT_ENHANCER_MODEL=deepseek-chat

ARK_API_KEY=your-ark-api-key
ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128

# Jimeng credentials. Required when SUPER_CANVAS_IMAGE_PROVIDER=jimeng
# or FINAL_PROPOSAL_IMAGE_PROVIDER=jimeng.
JIMENG_ACCESS_KEY_ID=your-volcengine-access-key-id
JIMENG_SECRET_ACCESS_KEY=your-volcengine-secret-access-key

# Required by super canvas motif transformation.
SUPER_CANVAS_IMAGE_PROVIDER=jimeng
# OpenAI-compatible/Ark generation timeout; independent of 30s image downloads.
SUPER_CANVAS_GENERATION_TIMEOUT_MS=180000
SUPER_CANVAS_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SUPER_CANVAS_ARK_MODEL=doubao-seedream-5-0-260128
SUPER_CANVAS_OPENAI_IMAGE_REQUEST_MODE=auto
SUPER_CANVAS_OPENAI_INCLUDE_OPTIONAL_PARAMS=false
SUPER_CANVAS_JIMENG_MAX_POLLS=120
SUPER_CANVAS_JIMENG_POLL_DELAY_MS=1000

# Required by final proposal generation.
FINAL_PROPOSAL_IMAGE_PROVIDER=jimeng
FINAL_PROPOSAL_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
FINAL_PROPOSAL_ARK_MODEL=doubao-seedream-5-0-260128
FINAL_PROPOSAL_OPENAI_IMAGE_REQUEST_MODE=auto
FINAL_PROPOSAL_OPENAI_INCLUDE_OPTIONAL_PARAMS=false
FINAL_PROPOSAL_JIMENG_MAX_POLLS=120
FINAL_PROPOSAL_JIMENG_POLL_DELAY_MS=1000
# Temporarily disables the auto-composed Chinese final proposal prompt.
FINAL_PROPOSAL_DISABLE_AUTO_PROMPT=false

# Optional OpenAI-compatible fallback.
OPENAI_API_KEY=your-openai-api-key
FINAL_PROPOSAL_OPENAI_BASE_URL=https://api.openai.com/v1
FINAL_PROPOSAL_OPENAI_IMAGE_MODEL=gpt-image-2
FINAL_PROPOSAL_OPENAI_IMAGE_QUALITY=low
FINAL_PROPOSAL_OPENAI_IMAGE_SIZE=1536x1024
FINAL_PROPOSAL_OPENAI_OUTPUT_FORMAT=png
FINAL_PROPOSAL_OPENAI_BACKGROUND=opaque

# Required when local/generated reference images must be sent to external image models.
# The URL must be publicly reachable by OpenAI/Jimeng, not localhost.
SUPER_CANVAS_PUBLIC_BASE_URL=https://your-public-backend.example.com
PUBLIC_ASSET_BASE_URL=https://your-public-backend.example.com
